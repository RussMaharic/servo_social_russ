# Vercel build: public URL of the deployed Render directory. No secret required.
T2_DIRECTORY_URL=https://servo-social-russ-1.onrender.com

# Optional directory storage path. Set on a service with a mounted persistent disk.
# T2_DIRECTORY_DB=/var/data/dexops-directory.sqlite3

# Optional companion state directory. Default stays ~/.config/t2_bots/connect.
# T2_CONNECT_HOME=/absolute/path/to/private/station-data
