# Vercel builds only need the public Render directory URL.
T2_DIRECTORY_URL=https://servo-social-russ-1.onrender.com

# Optional persistent SQLite path on Render; no external database keys required.
# T2_DIRECTORY_DB=/var/data/directory.sqlite3

# Optional private companion state directory. Default stays unchanged.
# T2_CONNECT_HOME=/absolute/path/to/private/station-data
