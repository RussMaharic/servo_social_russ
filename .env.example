# These are templates. Set hosting variables in each platform's dashboard.
# Local Python launchers do not automatically load .env files.

# RENDER FREE PILOT: no backend variables are required. The service uses its
# local SQLite database. Only Vercel needs the public Render URL:
# T2_DIRECTORY_URL=https://REPLACE_WITH_YOUR_DIRECTORY.onrender.com

# SIMPLE PILOT: Railway + SQLite. No secret is needed. Attach a Railway volume;
# its RAILWAY_VOLUME_MOUNT_PATH is supplied automatically and used by the app.
# Vercel only needs the generated Railway public address:
T2_DIRECTORY_URL=https://REPLACE_WITH_YOUR_DIRECTORY.up.railway.app

# OPTIONAL RENDER + SUPABASE ALTERNATIVE: private Postgres transaction-pooler URL.
# Use the t2_directory_app role and password set in the SQL Editor.
# URL-encode special characters in the password. Copy the actual pooler host
# from your project rather than guessing its region/hostname.
T2_DATABASE_URL=postgresql://t2_directory_app.fwamzeswdfhqtabakaib:REPLACE_PASSWORD@REPLACE_POOLER_HOST:6543/postgres
T2_SUPABASE_PROJECT_REF=fwamzeswdfhqtabakaib
T2_DIRECTORY_REQUIRE_POSTGRES=1

# Do not set database passwords, service-role keys or device credentials on Vercel.
