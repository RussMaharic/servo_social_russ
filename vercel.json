{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "python3 dexops/scripts/build-vercel-site.py",
  "installCommand": "",
  "outputDirectory": "dexops/src/t2_bots/connect/static",
  "headers": [
    {"source": "/(.*)", "headers": [
      {"key": "X-Content-Type-Options", "value": "nosniff"},
      {"key": "Referrer-Policy", "value": "no-referrer"},
      {"key": "X-Frame-Options", "value": "DENY"}
    ]},
    {"source": "/release.json", "headers": [{"key": "Cache-Control", "value": "no-store"}]},
    {"source": "/bootstrap.py", "headers": [{"key": "Cache-Control", "value": "no-store"}]},
    {"source": "/downloads/(.*)", "headers": [{"key": "Cache-Control", "value": "no-store"}]}
  ]
}
